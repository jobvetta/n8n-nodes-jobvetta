{
  "name": "n8n-nodes-jobvetta",
  "version": "1.0.2",
  "description": "Official n8n community node for the Jobvetta Jobs & Hiring Signals API (6.5M+ live employer career-site jobs across 242 countries).",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "jobvetta",
    "jobs",
    "job-search",
    "hiring-signals",
    "lead-generation",
    "recruiting"
  ],
  "license": "MIT",
  "homepage": "https://www.jobvetta.com/api",
  "author": {
    "name": "Sam Arora",
    "email": "sam@jobvetta.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jobvetta/n8n-nodes-jobvetta.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp nodes/Jobvetta/jobvetta*.svg dist/nodes/Jobvetta/ && cp credentials/jobvetta*.svg dist/credentials/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/JobvettaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Jobvetta/Jobvetta.node.js"
    ]
  },
  "devDependencies": {
    "n8n-workflow": "^1.80.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
